---
import Dial from './Dial.astro';
import { formatYears, decadeOf, formatRange, href, KIND_LABEL } from '../lib/site';

interface Props { entry: any; familyName: string; }
const { entry, familyName } = Astro.props;
const d = entry.data;
const years = formatYears(d.years);
const photo = d.images[0];
---
<!-- The title link stretches over the whole card, so the card stays one big
     target while the photo credit keeps a link of its own. -->
<article class="watch-card"
   data-family={d.family.id} data-kind={d.kind} data-decade={decadeOf(d.years) ?? 'unknown'}
   data-name={d.name} data-year={d.years.from ?? 9999} data-has-photo={photo ? 'yes' : 'no'}>
  <div class="watch-card__img">
    {photo ? <img src={photo.thumb} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy"> : <Dial kind={d.kind} />}
  </div>
  <div class="watch-card__body">
    <div class="watch-card__top">
      <div>
        <a class="watch-card__name" href={href.ref(entry.id)}>{d.name}</a>
        <span class="watch-card__meta">{familyName} · {KIND_LABEL[d.kind]}{years && ` · ${years}`}</span>
      </div>
      <span class="mono watch-card__ref">{d.references[0]?.number ?? 'ref. unknown'}</span>
    </div>
    <div class="watch-card__foot">
      <span>{d.movement.calibres.join(', ') || 'Calibre unknown'}</span>
      {d.status === 'draft' ? <span class="badge draft">Draft</span> : d.barometer ? <span class="mono">{formatRange(d.barometer)}</span> : <span class="badge verified">Verified</span>}
    </div>
    <p class="watch-card__credit">
      {photo
        ? <>Photo: <a href={photo.credit_url ?? photo.source_url} rel="noopener">{photo.credit}</a>, {photo.license}</>
        : 'No photo yet'}
    </p>
  </div>
</article>

<style>
  .watch-card { position: relative; display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; color: var(--ink); background: var(--paper); }
  .watch-card:hover { border-color: var(--ink); }
  .watch-card:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }
  .watch-card[hidden] { display: none; }
  .watch-card__img { background: var(--plate); aspect-ratio: 4 / 3; display: flex; align-items: center; justify-content: center; }
  .watch-card__img img { width: 100%; height: 100%; object-fit: cover; }
  .watch-card__body { padding: 16px; display: flex; flex-direction: column; gap: 10px; }
  .watch-card__top { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
  .watch-card__top > div { display: flex; flex-direction: column; gap: 2px; }
  .watch-card__name { font-size: 17px; font-weight: 600; line-height: 1.2; text-decoration: none; color: var(--ink); }
  .watch-card__name:focus-visible { outline: none; }
  .watch-card__name::after { content: ''; position: absolute; inset: 0; }
  .watch-card__meta { font-size: 13px; color: var(--muted); }
  .watch-card__ref { font-size: 12px; color: var(--muted); white-space: nowrap; }
  .watch-card__foot { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding-top: 10px; border-top: 1px solid var(--line-soft); font-size: 12px; color: var(--ink-2); }
  .watch-card__credit { margin: 0; font-size: 12px; color: var(--muted); }
  .watch-card__credit a { position: relative; z-index: 1; color: var(--muted); }
  .watch-card__credit a:hover { color: var(--accent); }
</style>
