---
import Dial from './Dial.astro';
import { formatYears, decadeOf, formatRange, href, KIND_LABEL } from '../lib/site';

interface Props { entry: any; familyName: string; }
const { entry, familyName } = Astro.props;
const d = entry.data;
const years = formatYears(d.years);
const photo = d.images[0];
---
<a class="watch-card" href={href.ref(entry.id)}
   data-family={d.family.id} data-kind={d.kind} data-decade={decadeOf(d.years) ?? 'unknown'}
   data-name={d.name} data-year={d.years.from ?? 9999} data-has-photo={photo ? 'yes' : 'no'}>
  <div class="watch-card__img">
    {photo ? <img src={photo.file} alt={photo.alt} loading="lazy"> : <Dial kind={d.kind} />}
    <span class="watch-card__credit">{photo ? `Photo: ${photo.credit}` : 'Photo wanted'}</span>
  </div>
  <div class="watch-card__body">
    <div class="watch-card__top">
      <div>
        <span class="watch-card__name">{d.name}</span>
        <span class="watch-card__meta">{familyName} · {KIND_LABEL[d.kind]}{years && ` · ${years}`}</span>
      </div>
      <span class="mono watch-card__ref">{d.reference ?? 'ref. unknown'}</span>
    </div>
    <div class="watch-card__foot">
      <span>{d.movement.calibre ?? 'Calibre unknown'}</span>
      {d.status === 'draft' ? <span class="badge draft">Draft</span> : d.barometer ? <span class="mono">{formatRange(d.barometer)}</span> : <span class="badge verified">Verified</span>}
    </div>
  </div>
</a>

<style>
  .watch-card { display: flex; flex-direction: column; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; text-decoration: none; color: var(--ink); background: var(--paper); }
  .watch-card:hover { border-color: var(--ink); color: var(--ink); }
  .watch-card[hidden] { display: none; }
  .watch-card__img { background: var(--plate); aspect-ratio: 4 / 3; display: flex; align-items: center; justify-content: center; position: relative; }
  .watch-card__img img { width: 100%; height: 100%; object-fit: cover; }
  .watch-card__credit { position: absolute; left: 12px; bottom: 10px; font-size: 11px; color: var(--muted); }
  .watch-card__body { padding: 16px; display: flex; flex-direction: column; gap: 10px; }
  .watch-card__top { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
  .watch-card__top > div { display: flex; flex-direction: column; gap: 2px; }
  .watch-card__name { font-size: 17px; font-weight: 600; line-height: 1.2; }
  .watch-card__meta { font-size: 13px; color: var(--muted); }
  .watch-card__ref { font-size: 12px; color: var(--muted); white-space: nowrap; }
  .watch-card__foot { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding-top: 10px; border-top: 1px solid var(--line-soft); font-size: 12px; color: var(--ink-2); }
</style>
