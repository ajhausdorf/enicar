---
import '../styles/global.css';
import { SITE_NAME, CONTRIBUTE_URL, USD_RATES } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  section?: 'catalog' | 'calibres' | 'serial' | 'coverage' | 'sources' | 'search';
  // Only watch pages go into the search index.
  searchable?: boolean;
}
const { title, description = 'An independent, sourced index of vintage Enicar watches.', section, searchable = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
// The 24-hour bezel strip under the header: 0 to 10 blue, 12 to 22 red.
const bezel = Array.from({ length: 24 }, (_, h) => ({ label: h % 2 ? '·' : String(h), night: h >= 12, dot: h % 2 === 1 }));
const nav = [
  { key: 'catalog', label: 'Catalog', href: '/' },
  { key: 'calibres', label: 'Calibres', href: '/calibres/' },
  { key: 'serial', label: 'Serials', href: '/serial/' },
  { key: 'coverage', label: 'Coverage', href: '/coverage/' },
  { key: 'sources', label: 'Sources', href: '/sources/' }
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=B612:wght@400;700&family=B612+Mono:wght@400;700&display=swap">
  <slot name="head" />
</head>
<body>
  <div class="page">
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <span>{SITE_NAME}</span>
        </a>
        <nav class="nav" aria-label="Primary">
          {nav.map((n) => <a href={n.href} aria-current={n.key === section ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <button type="button" class="cur-toggle" id="cur-toggle" aria-pressed="false" title={`Show prices in US dollars, at fixed rates set ${USD_RATES.asOf}`}>
          <span aria-hidden="true">$</span> USD<span class="sr-only"> prices</span>
        </button>
        <form class="search" action="/search/" method="get" role="search">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke-width="1.6"><circle cx="7" cy="7" r="5"></circle><path d="M11 11l3.5 3.5"></path></svg>
          <label for="site-q" class="sr-only">Search references, nicknames, calibres</label>
          <input id="site-q" name="q" type="search" placeholder="Search a reference, nickname or calibre">
        </form>
      </div>
    </header>
    <div class="bezel" aria-hidden="true">
      {bezel.map((b) => <span class:list={[{ night: b.night, dot: b.dot }]}>{b.label}</span>)}
    </div>

    <script is:inline define:vars={{ rates: USD_RATES.rates, asOf: USD_RATES.asOf }}>
      // Price currency toggle: rewrites every .money element to US dollars at the
      // fixed rates, or back to the original. The choice is kept per visitor in
      // localStorage; prices always render in their original currency first.
      (() => {
        const KEY = 'ew-currency';
        const get = () => { try { return localStorage.getItem(KEY) === 'USD' ? 'USD' : 'orig'; } catch { return 'orig'; } };
        const set = (m) => { try { localStorage.setItem(KEY, m); } catch {} };
        const round = (v) => Math.round(v / 10) * 10;
        const usd = (v) => '$' + round(v).toLocaleString('en-US');
        const apply = (mode) => {
          for (const el of document.querySelectorAll('.money')) {
            if (el.dataset.orig == null) el.dataset.orig = el.textContent;
            const r = rates[el.dataset.cur];
            if (mode !== 'USD' || el.dataset.cur === 'USD' || !r) { el.textContent = el.dataset.orig; continue; }
            if (el.dataset.v != null) el.textContent = '≈ ' + usd(+el.dataset.v * r);
            else {
              const hi = +el.dataset.hi * r;
              el.textContent = el.dataset.lo == null ? '≈ up to ' + usd(hi) : '≈ ' + usd(+el.dataset.lo * r) + ' to ' + round(hi).toLocaleString('en-US');
            }
            el.setAttribute('aria-label', el.textContent + ' (' + el.dataset.orig + ' converted at rates set ' + asOf + ')');
          }
          for (const n of document.querySelectorAll('[data-usd-note]')) n.hidden = mode !== 'USD';
          const b = document.getElementById('cur-toggle');
          if (b) b.setAttribute('aria-pressed', String(mode === 'USD'));
        };
        const start = () => {
          apply(get());
          document.getElementById('cur-toggle')?.addEventListener('click', () => { const m = get() === 'USD' ? 'orig' : 'USD'; set(m); apply(m); });
        };
        document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', start) : start();
      })();
    </script>

    <main data-pagefind-body={searchable ? '' : undefined}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>{SITE_NAME} is an independent, non-commercial project. The research behind each record comes from the sources credited on its page. Enicar is a trademark of its current owner, and this site isn't affiliated with them.</p>
        <nav aria-label="Footer">
          <a href="/sources/">Sources and credits</a>
          <a href="/coverage/">Catalogue coverage</a>
          <a href={CONTRIBUTE_URL}>Request a correction</a>
        </nav>
      </div>
    </footer>
  </div>
</body>
</html>
