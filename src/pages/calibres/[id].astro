---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { calibreUsage, leavesOf, slugify, calibreId, CONTRIBUTE_URL } from '../../lib/site';

export async function getStaticPaths() {
  const calibres = await getCollection('calibres');
  return calibres.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const all = await getCollection('calibres');
const base = d.base ? await getEntry(d.base) : null;
const derived = all.filter((c) => c.data.base?.id === entry.id);
const used = calibreUsage(await getCollection('references')).get(entry.id) ?? [];
const sources = Object.fromEntries((await getCollection('sources')).map((s) => [s.id, s]));
const cites = Object.fromEntries(d.citations.map((c) => [c.id, c]));
const srcName = (c: any) => sources[c.source.id]?.data.name;

const WINDING: Record<string, string> = { manual: 'Hand-wound', automatic: 'Automatic', electric: 'Electric (battery)', quartz: 'Quartz' };
const size = [d.lignes && `${d.lignes} lignes`, d.diameter_mm && `${d.diameter_mm} mm`].filter(Boolean).join(', ') || null;
const specs = [
  ['Maker', d.maker],
  ['Winding', d.winding ? WINDING[d.winding] : null],
  ['Functions', d.functions.join(', ') || null],
  ['Size', size],
  ['Height', d.height_mm && `${d.height_mm} mm`],
  ['Jewels', d.jewels],
  ['Beat rate', d.beat_rate],
  ['Power reserve', d.power_reserve ?? (d.winding === 'electric' ? 'Battery' : null)]
] as const;

// Photos: this calibre's own, then movement photos from watch pages whose
// watch (or generation) uses this calibre and no other, so the movement shown
// can only be this one. On a model with generations the photo must be tagged
// with one, or it could be another generation's movement.
const fromWatches = (await getCollection('references')).flatMap((r) => leavesOf(r)
  .filter((l) => l.calibres.length === 1 && calibreId(l.calibres[0]) === entry.id)
  .flatMap((l) => l.images.filter((i: any) => i.view === 'movement' && (!l.ref.data.variants.length || i.variant)).map((i: any) => ({ ...i, from: { name: l.name, path: l.path } }))));
const seenPhoto = new Set<string>();
const photos = [...d.images, ...fromWatches].filter((i: any) => !seenPhoto.has(i.file) && seenPhoto.add(i.file));
---
<Base title={`Calibre ${d.name}`} description={`The Enicar ${d.name} movement and the watches that used it.`} section="calibres" searchable>
  <div class="wrap calibre">
    <nav aria-label="Breadcrumb" class="crumbs">
      <a href="/calibres/">Calibres</a><span aria-hidden="true">/</span><span aria-current="page">{d.name}</span>
    </nav>

    {d.status === 'draft' && (
      <p class="notice" data-pagefind-ignore><strong>Draft record.</strong> We're still checking this one against its sources, so it may be incomplete.</p>
    )}

    <section class="head">
      <p class="eyebrow">Calibre</p>
      <h1 class="mono">{d.name}</h1>
      {d.base_note && <p class="lede">{d.base_note}</p>}
    </section>

    <dl class="specs">
      {specs.map(([k, v]) => <div><dt>{k}</dt><dd class={v ? '' : 'unknown'}>{v ?? 'Unknown'}</dd></div>)}
      {base && <div><dt>Based on</dt><dd><a href={`/calibres/${base.id}/`}>{base.data.name}</a></dd></div>}
      {derived.length > 0 && <div><dt>Basis for</dt><dd>{derived.map((c, i) => <>{i > 0 && ', '}<a href={`/calibres/${c.id}/`}>{c.data.name}</a></>)}</dd></div>}
    </dl>

    {photos.length > 0 ? (
      <section class="photos" aria-labelledby="ph-h" data-pagefind-ignore>
        <h2 id="ph-h">Photos</h2>
        <ul>
          {photos.map((p: any) => (
            <li>
              <figure>
                <a href={p.file} class="ph-img"><img src={p.thumb} alt={p.alt} width={p.width} height={p.height} loading="lazy"></a>
                <figcaption>
                  Photo: {p.credit_url ? <a href={p.credit_url}>{p.credit}</a> : p.credit}{p.permission !== 'granted' && ` · ${p.license}`} · <a href={p.source_url}>original</a>
                  {p.from && <span class="from">In the <a href={p.from.path}>{p.from.name}</a></span>}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </section>
    ) : (
      <p class="muted small" data-pagefind-ignore>No photo of this movement yet.</p>
    )}

    {d.notes.length > 0 && (
      <section class="notes">
        <h2>Notes</h2>
        <ul>{d.notes.map((n) => <li>{n.text} {n.cites.map((id) => cites[id] && <a class="cite" href={cites[id].url}>{srcName(cites[id])}</a>)}</li>)}</ul>
      </section>
    )}

    <section class="used">
      <h2>Watches with this calibre</h2>
      {used.length === 0 ? <p class="muted">None recorded yet.</p> : (
        <ul>
          {used.flatMap((u) => u.variants.length
            ? u.variants.map((v) => ({ name: `${u.ref.data.name} ${v}`, path: `/ref/${u.ref.id}/${slugify(v)}/` }))
            : [{ name: u.ref.data.name, path: leavesOf(u.ref)[0].path }]
          ).map((l) => (
            <li class="card"><a href={l.path}><strong>{l.name}</strong></a></li>
          ))}
        </ul>
      )}
    </section>

    {d.read_more.length > 0 && (
      <section class="read-more">
        <h2>Further reading</h2>
        <ul>{d.read_more.map((m) => <li><a href={m.url}>{m.title}</a> <span class="muted small">{sources[m.source.id]?.data.name}</span></li>)}</ul>
      </section>
    )}

    <section class="bottom" data-pagefind-ignore>
      <div>
        <h2>Sources</h2>
        {d.citations.length === 0 ? <p class="muted small">No sources cited yet.</p> : (
          <ul>{d.citations.map((c) => <li><a href={c.url}>{c.title}</a> <span class="muted small">{srcName(c)} · read {c.retrieved.toISOString().slice(0, 10)}</span></li>)}</ul>
        )}
      </div>
      {d.gaps.length > 0 && (
        <div>
          <h2>Still missing</h2>
          <ul>{d.gaps.map((g) => <li>{g}</li>)}</ul>
          <a href={CONTRIBUTE_URL}>Know any of these? Send a correction</a>
        </div>
      )}
    </section>
  </div>
</Base>

<style>
  .calibre { display: flex; flex-direction: column; gap: 32px; padding-top: 24px; padding-bottom: 64px; }
  .crumbs { font-size: 13px; color: var(--muted); display: flex; gap: 8px; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .notice { margin: 0; }
  .head { display: flex; flex-direction: column; gap: 12px; }
  .small { font-size: 13px; }
  .specs { margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); column-gap: 24px; border-top: 1px solid var(--line); max-width: 900px; }
  .specs div { display: flex; flex-direction: column; gap: 2px; padding: 12px 0; border-bottom: 1px solid var(--line-soft); }
  .specs dt { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .specs dd { margin: 0; font-size: 15px; font-weight: 500; }
  .specs dd.unknown { color: var(--muted); font-weight: 400; }
  .notes, .used, .read-more { display: flex; flex-direction: column; gap: 12px; max-width: 900px; }
  .notes ul, .read-more ul, .bottom ul { margin: 0; padding-left: 20px; display: flex; flex-direction: column; gap: 6px; }
  .used ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
  .used li { padding: 14px 16px; display: flex; flex-direction: column; gap: 4px; }
  .used a { text-decoration: none; }
  .bottom { display: flex; flex-wrap: wrap; gap: 40px; }
  .photos { display: flex; flex-direction: column; gap: 12px; max-width: 900px; }
  .photos ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
  .photos figure { margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .ph-img { display: block; aspect-ratio: 1; overflow: hidden; border-radius: 8px; background: var(--photo-ground); cursor: zoom-in; }
  .ph-img img { width: 100%; height: 100%; object-fit: cover; }
  .photos figcaption { font-size: 12px; color: var(--muted); display: flex; flex-direction: column; gap: 2px; }
  .photos figcaption a { color: var(--muted); }
  .bottom > div { flex: 1 1 320px; display: flex; flex-direction: column; gap: 12px; }
</style>
