---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import WatchCard from '../components/WatchCard.astro';
import { KIND_LABEL, decadeOf } from '../lib/site';

const families = (await getCollection('families')).sort((a, b) => a.data.order - b.data.order);
const familyName = Object.fromEntries(families.map((f) => [f.id, f.data.name]));
const refs = (await getCollection('references')).sort((a, b) =>
  (families.findIndex((f) => f.id === a.data.family.id) - families.findIndex((f) => f.id === b.data.family.id)) ||
  a.data.name.localeCompare(b.data.name));

const counts = Object.fromEntries(families.map((f) => [f.id, refs.filter((r) => r.data.family.id === f.id).length]));
const verified = refs.filter((r) => r.data.status === 'verified').length;
const kinds = [...new Set(refs.map((r) => r.data.kind))].sort();
const decades = [...new Set(refs.map((r) => decadeOf(r.data.years)).filter(Boolean))].sort() as string[];
---
<Base section="catalog">
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__text">
        <h1>Enicar World</h1>
        <p class="lede">Specs, generations, reference numbers and calibres for vintage Enicar watches. Each record lists its sources. Most are still drafts.</p>
      </div>
      <dl class="stats">
        <div><dt>References</dt><dd class="mono">{refs.length}</dd></div>
        <div><dt>Verified</dt><dd class="mono">{verified}</dd></div>
        <div><dt>Families</dt><dd class="mono">{families.length}</dd></div>
      </dl>
    </div>
  </section>

  <div class="toolbar">
    <div class="wrap toolbar__inner">
      <label class="ctl">Type
        <select id="f-kind">
          <option value="">All types</option>
          {kinds.map((k) => <option value={k}>{KIND_LABEL[k]}</option>)}
        </select>
      </label>
      <label class="ctl">Decade
        <select id="f-decade">
          <option value="">Any decade</option>
          {decades.map((d) => <option value={d}>{d}</option>)}
          <option value="unknown">Undated</option>
        </select>
      </label>
      <button type="button" class="chip" id="f-photo" aria-pressed="false">Has photo</button>
      <label class="ctl ctl--end">Sort
        <select id="f-sort">
          <option value="family">Family, then name</option>
          <option value="name">Name, A to Z</option>
          <option value="year">Year introduced</option>
        </select>
      </label>
    </div>
  </div>

  <div class="wrap layout">
    <aside class="families" aria-label="Families">
      <p class="eyebrow">Families</p>
      <button type="button" class="fam" data-family="" aria-pressed="true"><span>All</span><span class="mono">{refs.length}</span></button>
      {families.map((f) => (
        <button type="button" class="fam" data-family={f.id} aria-pressed="false"><span>{f.data.name}</span><span class="mono">{counts[f.id]}</span></button>
      ))}
      <div class="panel about">
        <strong>Drafts</strong>
        <span>A record stays a draft until every detail on it is backed by a source.</span>
        <a href="/coverage/">Coverage so far</a>
      </div>
    </aside>

    <section class="results" aria-labelledby="results-h">
      <div class="results__head">
        <h2 id="results-h">All references</h2>
        <span class="muted" id="shown" aria-live="polite">{refs.length} shown</span>
      </div>
      <div class="grid" id="grid">
        {refs.map((r) => <WatchCard entry={r} familyName={familyName[r.data.family.id]} />)}
      </div>
      <p class="empty" id="empty" hidden>No references match these filters.</p>
    </section>
  </div>
</Base>

<script>
  const grid = document.getElementById('grid')!;
  const cards = [...grid.querySelectorAll<HTMLElement>('.watch-card')];
  const order = new Map(cards.map((c, i) => [c, i]));
  const famButtons = [...document.querySelectorAll<HTMLButtonElement>('.fam')];
  const kind = document.getElementById('f-kind') as HTMLSelectElement;
  const decade = document.getElementById('f-decade') as HTMLSelectElement;
  const photo = document.getElementById('f-photo') as HTMLButtonElement;
  const sort = document.getElementById('f-sort') as HTMLSelectElement;
  const heading = document.getElementById('results-h')!;
  const shown = document.getElementById('shown')!;
  const empty = document.getElementById('empty')!;
  let family = new URLSearchParams(location.search).get('family') ?? '';

  function apply() {
    let n = 0;
    for (const c of cards) {
      const ok = (!family || c.dataset.family === family) &&
        (!kind.value || c.dataset.kind === kind.value) &&
        (!decade.value || c.dataset.decade === decade.value) &&
        (photo.getAttribute('aria-pressed') !== 'true' || c.dataset.hasPhoto === 'yes');
      c.hidden = !ok;
      if (ok) n++;
    }
    const sorted = [...cards].sort((a, b) =>
      sort.value === 'name' ? a.dataset.name!.localeCompare(b.dataset.name!) :
      sort.value === 'year' ? Number(a.dataset.year) - Number(b.dataset.year) :
      order.get(a)! - order.get(b)!);
    grid.append(...sorted);
    for (const b of famButtons) b.setAttribute('aria-pressed', String(b.dataset.family === family));
    const active = famButtons.find((b) => b.dataset.family === family);
    heading.textContent = family && active ? `${active.firstElementChild!.textContent} family` : 'All references';
    shown.textContent = `${n} shown`;
    empty.hidden = n > 0;
    const url = new URL(location.href);
    family ? url.searchParams.set('family', family) : url.searchParams.delete('family');
    history.replaceState(null, '', url);
  }
  for (const b of famButtons) b.addEventListener('click', () => { family = b.dataset.family ?? ''; apply(); });
  photo.addEventListener('click', () => { photo.setAttribute('aria-pressed', String(photo.getAttribute('aria-pressed') !== 'true')); apply(); });
  for (const el of [kind, decade, sort]) el.addEventListener('change', apply);
  apply();
</script>

<style>
  .hero { border-bottom: 1px solid var(--line); }
  .hero__inner { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 32px; padding-top: 56px; padding-bottom: 32px; }
  .hero__text { flex: 1 1 520px; display: flex; flex-direction: column; gap: 16px; }
  .stats { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; flex: 0 1 400px; }
  .stats div { display: flex; flex-direction: column; gap: 4px; }
  .stats dt { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; }
  .stats dd { margin: 0; font-size: 32px; font-weight: 600; }
  .toolbar { border-bottom: 1px solid var(--line); background: var(--wash); }
  .toolbar__inner { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; padding-top: 14px; padding-bottom: 14px; }
  .ctl { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--muted); }
  .ctl--end { margin-left: auto; }
  .ctl select { min-height: 40px; border: 1px solid var(--line); border-radius: 6px; background: var(--paper); font: inherit; font-size: 13px; padding: 0 10px; color: var(--ink); }
  .layout { display: flex; flex-wrap: wrap; gap: 32px; padding-top: 32px; padding-bottom: 56px; }
  .families { flex: 1 1 200px; max-width: 240px; display: flex; flex-direction: column; gap: 4px; }
  .families .eyebrow { margin-bottom: 8px; }
  .fam { display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 44px; padding: 0 10px; border: 0; border-radius: 6px; background: transparent; color: var(--ink); font: inherit; font-size: 14px; text-align: left; cursor: pointer; }
  .fam .mono { font-size: 12px; color: var(--muted); }
  .fam[aria-pressed='true'] { background: var(--plate); color: var(--accent); font-weight: 600; }
  .about { margin-top: 20px; padding: 16px; display: flex; flex-direction: column; gap: 8px; font-size: 13px; color: var(--ink-2); }
  .about strong { color: var(--ink); }
  .results { flex: 999 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .results__head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; flex-wrap: wrap; }
  .results__head h2 { font-size: 20px; }
  .results__head span { font-size: 13px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px; }
  .empty { color: var(--muted); }
  @media (max-width: 720px) {
    .families { max-width: none; flex-direction: row; flex-wrap: wrap; }
    .families .eyebrow, .about { flex-basis: 100%; }
    .fam { flex: 0 0 auto; gap: 8px; }
    .ctl--end { margin-left: 0; }
  }
</style>
