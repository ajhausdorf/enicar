---
// One page per generation (/ref/sherpa-jet/mki/), or per model when the
// model has no generations (/ref/sherpa-graph/). Models with generations
// don't get a page of their own; the catalog filters to them instead.
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Dial from '../../components/Dial.astro';
import Money from '../../components/Money.astro';
import PriceHistory from '../../components/PriceHistory.astro';
import { formatYears, barometerOf, USD_RATES, LISTING_FRESH_DAYS, href, KIND_LABEL, CONTRIBUTE_URL, leavesOf } from '../../lib/site';

export async function getStaticPaths() {
  const refs = await getCollection('references');
  return refs.flatMap((ref) => leavesOf(ref).map((leaf) => ({ params: { slug: leaf.slug }, props: { leaf } })));
}

const { leaf } = Astro.props;
const entry = leaf.ref;
const d = entry.data;
const v = leaf.variant;
const family = await getEntry(d.family);
const sources = Object.fromEntries((await getCollection('sources')).map((s) => [s.id, s]));
const cites = Object.fromEntries(d.citations.map((c) => [c.id, c]));
const otherModels = (await getCollection('references', (r) => r.data.family.id === d.family.id && r.id !== entry.id))
  .sort((a, b) => a.data.name.replace(/^Sherpa /, '').localeCompare(b.data.name.replace(/^Sherpa /, '')));
const generations = leavesOf(entry);

// Prices: the price guide for this generation (or model), then sales and
// listings for it. A sale with no generation shows on every generation page.
const bar = barometerOf(leaf);
const barCite = bar ? cites[bar.cite] : null;
const salesHere = await getCollection('sales', (s) => s.data.ref.id === entry.id && (!v || !s.data.variant || s.data.variant === v.name));
const fresh = (dt: Date) => (Date.now() - dt.getTime()) / 864e5 <= LISTING_FRESH_DAYS;
const byDate = (a: any, b: any) => +b.data.date - +a.data.date;
const sold = salesHere.filter((s) => s.data.kind === 'sold' && (!v || s.data.variant)).sort(byDate).slice(0, 12);
// On a generation page, sales of the model whose generation isn't known.
const soldModel = v ? salesHere.filter((s) => s.data.kind === 'sold' && !s.data.variant).sort(byDate).slice(0, 12) : [];
const listed = salesHere.filter((s) => s.data.kind === 'listed' && s.data.checked && fresh(s.data.checked)).sort((a, b) => a.data.price - b.data.price);
const day = (dt: Date) => dt.toISOString().slice(0, 10);

const mm = (n: number | number[] | null) => (n == null ? null : Array.isArray(n) ? `${n.join(' or ')} mm` : `${n} mm`);
const FEATURE: Record<string, string> = {
  'two-crowns': 'Two crowns', 'one-crown': 'One crown', 'inner-bezel': 'Inner bezel', 'outer-bezel': 'Outer bezel',
  'red-pointer-ring': 'Red pointer ring', 'crown-protection': 'Crown guards', 'tachymeter-ring': 'Tachymeter ring', 'cushion-case': 'Cushion case'
};
const calibres = leaf.calibres;
const specs = [
  ['Produced', formatYears(leaf.years)],
  ['Type', KIND_LABEL[d.kind]],
  ['Movement', calibres.length || d.movement.winding ? 'movement' : null],
  ['Case', v?.case ?? d.case.construction],
  ['Material', d.case.material],
  ['Diameter', mm(v?.diameter_mm ?? d.case.diameter_mm)],
  ['Lug width', mm(v?.lug_mm ?? d.case.lug_mm)],
  ['Thickness', mm(d.case.thickness_mm)],
  ['Dial', v?.dials.length ? v.dials.join(', ') : d.dial],
  ['Hands', v?.hands ?? null],
  ['Bezel', v?.bezel ?? null],
  ['Crowns', v?.crowns ?? null],
  ['Features', d.features.map((f) => FEATURE[f]).join(', ') || null],
  ['Factory refs', v?.refs.length ? v.refs.join(', ') : null],
  ['Serials seen', v?.serials.length ? v.serials.join(', ') : null],
  ['Dated', v?.dated ?? null],
  ['Made (estimate)', v?.production ? `${v.production} watches, estimated from serial ranges` : null],
  ['Nicknames', d.nicknames.join(', ') || null],
  ['References', d.references.map((r) => r.number).join(', ') || null]
] as const;
const alwaysShow = ['Produced', 'Movement', 'Case', 'Diameter', 'References'];

const vYears = (y: { from: number | null; to: number | null }) =>
  y.from && y.to ? (y.from === y.to ? `${y.from}` : `${y.from} to ${y.to}`) : y.from ? `${y.from} onward` : '';
const rows = [
  ['Years', (x: any) => vYears(x.years)],
  ['Diameter', (x: any) => mm(x.diameter_mm)],
  ['Lugs', (x: any) => mm(x.lug_mm)],
  ['Calibre', (x: any) => x.calibres.join(', ')],
  ['Case', (x: any) => x.case],
  ['Factory refs', (x: any) => x.refs.join(', ')],
  ['Dated', (x: any) => x.dated],
  ['Made (est.)', (x: any) => (x.production ? `${x.production}` : null)]
] as const;
const usedRows = rows.filter(([, f]) => d.variants.some((x) => f(x)));
const specCites = (v ? v.cites : []).map((id) => cites[id]).filter(Boolean);
const images = leaf.images;
const [hero] = images;
const eyebrow = [family?.data.name, KIND_LABEL[d.kind]].filter(Boolean).join(' · ');
const usedSources = [...new Set(d.citations.map((c) => c.source.id))].map((id) => sources[id]).filter(Boolean);
const srcName = (c: any) => sources[c.source.id]?.data.name;
// Photo links for this generation, plus any that cover every generation.
const elsewhere = d.photos_elsewhere.filter((p) => !p.variant || p.variant === v?.name);
const readMore = d.read_more.filter((m) => !m.variant || m.variant === v?.name);
---
<Base title={leaf.name} description={`${leaf.name}${v ? `, ${vYears(v.years)}` : ''}. ${d.summary ?? ''}`.trim()} section="catalog" searchable>
  <div class="wrap model">
    <nav aria-label="Breadcrumb" class="crumbs">
      <a href="/">Catalog</a><span aria-hidden="true">/</span>
      <a href={href.family(d.family.id)}>{family?.data.name}</a><span aria-hidden="true">/</span>
      {v ? (
        <><a href={href.model(d.family.id, entry.id)}>{d.name}</a><span aria-hidden="true">/</span><span aria-current="page">{v.name}</span></>
      ) : <span aria-current="page">{d.name}</span>}
    </nav>

    {d.status === 'draft' && (
      <p class="notice" data-pagefind-ignore><strong>Draft record.</strong> We're still checking this one against its sources, so it may be incomplete. What's missing is listed at the bottom.</p>
    )}

    <section class="top">
      <div class="gallery" data-pagefind-ignore>
        <figure class="hero-img">
          <div class="plate">
            {hero ? <img id="hero-img" src={hero.file} alt={hero.alt} width={hero.width} height={hero.height}> : <Dial kind={d.kind} size={300} />}
          </div>
          <figcaption id="hero-cap">
            {hero ? <>{hero.caption && <span class="cap-text">{hero.caption} </span>}Photo: {hero.credit_url ? <a href={hero.credit_url}>{hero.credit}</a> : hero.credit}{hero.permission !== 'granted' && ` · ${hero.license}`} · <a href={hero.source_url}>original</a></> : (elsewhere.length ? 'No photo with permission yet; see the links below.' : 'Photo wanted. Own one? Send it in with permission to publish.')}
          </figcaption>
        </figure>
        {images.length > 1 && (
          <ul class="thumbs">
            {images.map((t, i) => (
              <li><button type="button" class="thumb" aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Show photo: ${t.alt}`}
                data-file={t.file} data-alt={t.alt} data-w={t.width} data-h={t.height}
                data-variant="" data-caption={t.caption ?? ''} data-credit={t.credit} data-credit-url={t.credit_url ?? ''} data-license={t.permission === 'granted' ? '' : t.license} data-source={t.source_url}>
                <img src={t.thumb} alt="" loading="lazy">
              </button></li>
            ))}
          </ul>
        )}
        {elsewhere.length > 0 && (
          <div class="elsewhere">
            <strong>Photos elsewhere</strong>
            <span class="small muted">We don't have permission to show these here, so these links go to the photographers' own pages.</span>
            <ul>{elsewhere.map((p) => <li><a href={p.url} rel="noopener">{p.label}</a></li>)}</ul>
          </div>
        )}
      </div>

      <div class="facts">
        <div class="title">
          <p class="eyebrow">{eyebrow}</p>
          <h1>{leaf.name}</h1>
          {v ? <p class="tell"><strong>How to tell:</strong> {v.tell}</p> : d.summary && <p class="lede">{d.summary}</p>}
          <span class={`badge ${d.status}`}>{d.status === 'draft' ? 'Draft' : 'Verified'}</span>
        </div>

        {generations.length > 1 && (
          <nav class="gen-nav" aria-label={`${d.name} generations`} data-pagefind-ignore>
            <span>{d.name}</span>
            {generations.map((g) => <a href={g.path} aria-current={g.slug === leaf.slug ? 'page' : undefined}>{g.variant?.name}</a>)}
          </nav>
        )}

        <div class="card barometer">
          <div class="row"><span class="label">Price guide</span>
            {barCite && <a class="muted small" href={barCite.url}>Source: {srcName(barCite)}, {bar.edition}</a>}
          </div>
          {bar ? (
            <>
              {bar.entries.map((e: any) => (
                <div class="bar-entry">
                  {e.label && <span class="bar-label">{e.label}</span>}
                  <dl class="bands">
                    {e.bands.map((b: any) => <div><dt>{b.condition}</dt><dd class="mono"><Money currency={bar.currency} low={b.low} high={b.high} /></dd></div>)}
                  </dl>
                  {e.note && <span class="muted small">{e.note}</span>}
                  <PriceHistory entry={e} edition={bar.edition} currency={bar.currency} />
                </div>
              ))}
              <span class="muted small">Figures as published, never re-priced by us.<span data-usd-note hidden> Shown in US dollars at fixed rates set {USD_RATES.asOf}; switch back for the published figures.</span></span>
            </>
          ) : (
            <span class="muted small">No price guide yet.</span>
          )}
          {(sold.length > 0 || listed.length > 0 || soldModel.length > 0) && (
            <a class="small" href="#sales">{[sold.length && `${sold.length} ${sold.length === 1 ? 'sale' : 'sales'}`, soldModel.length && `${soldModel.length} ${d.name} ${soldModel.length === 1 ? 'sale' : 'sales'}, generation not stated`, listed.length && `${listed.length} for sale now`].filter(Boolean).join(' · ')}</a>
          )}
        </div>

        <dl class="specs">
          {specs.filter(([k, val]) => val || alwaysShow.includes(k)).map(([k, val]) => (
            <div><dt>{k}</dt><dd class={val ? '' : 'unknown'}>{
              k === 'Movement' && val
                ? <>{calibres.map((c, i) => <>{i > 0 && ', '}<a href={href.calibre(c)}>{c}</a></>)}{d.movement.winding && `${calibres.length ? ' · ' : ''}${d.movement.winding}`}</>
                : val ?? 'Unknown'
            }</dd></div>
          ))}
        </dl>
        {specCites.length > 0 && <p class="small muted">Specs from {specCites.map((c) => <a class="cite" href={c.url}>{srcName(c)}</a>)}</p>}
        {d.references.some((r) => r.note) && (
          <ul class="ref-notes small muted">
            {d.references.map((r) => <li><span class="mono">{r.number}</span>: {r.note} {r.cites.map((id) => cites[id] && <a class="cite" href={cites[id].url}>{srcName(cites[id])}</a>)}</li>)}
          </ul>
        )}
      </div>
    </section>

    {(sold.length > 0 || listed.length > 0 || soldModel.length > 0) && (
      <section class="sales" id="sales" aria-labelledby="sales-h" data-pagefind-ignore>
        <h2 id="sales-h">Sales and listings</h2>
        {listed.length > 0 && (
          <div class="sales__group">
            <h3>For sale now</h3>
            <div class="table-wrap"><table class="sales-table">
              <thead><tr><th scope="col">Asking</th><th scope="col">Where</th><th scope="col">Watch</th><th scope="col">Checked</th></tr></thead>
              <tbody>{listed.map((s) => (
                <tr><td class="mono"><Money currency={s.data.currency} value={s.data.price} /></td><td>{s.data.venue}</td>
                  <td><a href={s.data.url} rel="noopener">{s.data.title}</a>{v && !s.data.variant && <span class="muted"> (generation not stated)</span>}{s.data.condition && <span class="muted"> · {s.data.condition}</span>}</td>
                  <td class="mono muted">{day(s.data.checked!)}</td></tr>
              ))}</tbody>
            </table></div>
          </div>
        )}
        {sold.length > 0 && (
          <div class="sales__group">
            <h3>Sales results</h3>
            <div class="table-wrap"><table class="sales-table">
              <thead><tr><th scope="col">Date</th><th scope="col">Price</th><th scope="col">Where</th><th scope="col">Watch</th></tr></thead>
              <tbody>{sold.map((s) => (
                <tr><td class="mono muted">{day(s.data.date)}</td><td class="mono"><Money currency={s.data.currency} value={s.data.price} /></td><td>{s.data.venue}</td>
                  <td><a href={s.data.url} rel="noopener">{s.data.title}</a>{s.data.note && <span class="muted"> · {s.data.note}</span>}</td></tr>
              ))}</tbody>
            </table></div>
          </div>
        )}
        {soldModel.length > 0 && (
          <div class="sales__group">
            <h3>{d.name} sales, generation not stated</h3>
            <div class="table-wrap"><table class="sales-table">
              <thead><tr><th scope="col">Date</th><th scope="col">Price</th><th scope="col">Where</th><th scope="col">Watch</th></tr></thead>
              <tbody>{soldModel.map((s) => (
                <tr><td class="mono muted">{day(s.data.date)}</td><td class="mono"><Money currency={s.data.currency} value={s.data.price} /></td><td>{s.data.venue}</td>
                  <td><a href={s.data.url} rel="noopener">{s.data.title}</a>{s.data.note && <span class="muted"> · {s.data.note}</span>}</td></tr>
              ))}</tbody>
            </table></div>
          </div>
        )}
        <p class="muted small">Prices in the currency of the sale. Auction prices are as the house publishes them, which may include its buyer's premium. Asking prices are what a seller wants, not what a watch sells for; each listing was open on the date checked.</p>
      </section>
    )}

    {readMore.length > 0 && (
      <section class="read-more" aria-labelledby="rm-h">
        <h2 id="rm-h">Read the full story</h2>
        <ul>
          {readMore.map((m) => (
            <li class="card">
              <a href={m.url} class="rm-title">{m.title}
                <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l6-6M5 3h4v4"></path></svg>
              </a>
              <span class="muted small">{sources[m.source.id]?.data.name}{sources[m.source.id]?.data.author && `, ${sources[m.source.id].data.author}`}</span>
              {m.note && <span class="small">{m.note}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {v && usedRows.length > 0 && (
      <section class="gens" aria-labelledby="gen-h" data-pagefind-ignore>
        <div class="gens__head"><h2 id="gen-h">{d.name} generations compared</h2></div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th scope="col"><span class="sr-only">Spec</span></th>{generations.map((g) => (
                <th scope="col" class={g.slug === leaf.slug ? 'current' : ''}>{g.slug === leaf.slug ? g.variant?.name : <a href={g.path}>{g.variant?.name}</a>}</th>
              ))}</tr>
            </thead>
            <tbody>
              {usedRows.map(([label, f]) => (
                <tr><th scope="row">{label}</th>{generations.map((g) => <td class={g.slug === leaf.slug ? 'current' : ''}>{f(g.variant) || '—'}</td>)}</tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {d.history.length > 0 && (
      <section class="history">
        <h2>History</h2>
        {d.history.map((p) => (
          <p>{p.text} {p.cites.map((id) => cites[id] && <a class="cite" href={cites[id].url}>{srcName(cites[id])}</a>)}</p>
        ))}
      </section>
    )}

    <section class="bottom" data-pagefind-ignore>
      <div class="sources-list">
        <h2>Sources</h2>
        {d.citations.length === 0 ? <p class="muted small">No sources cited yet.</p> : (
          <ol>
            {d.citations.map((c) => (
              <li class="card src">
                <a href={c.url}><strong>{c.title}</strong></a>
                <span class="muted small">{srcName(c)} · read {c.retrieved.toISOString().slice(0, 10)}{sources[c.source.id]?.data.tier === 'listing' ? ' · dealer listing' : ''}</span>
              </li>
            ))}
          </ol>
        )}
      </div>
      {d.gaps.length > 0 && (
        <div class="gaps">
          <h2>Still missing</h2>
          <ul>{d.gaps.map((g) => <li>{g}</li>)}</ul>
          <a href={CONTRIBUTE_URL}>Know any of these? Send a correction</a>
        </div>
      )}
    </section>

    {otherModels.length > 0 && (
      <section class="siblings" data-pagefind-ignore>
        <h2>More in the {family?.data.name} family</h2>
        <ul>{otherModels.map((s) => <li><a href={leavesOf(s).length > 1 ? href.model(d.family.id, s.id) : leavesOf(s)[0].path}>{s.data.name}</a></li>)}</ul>
      </section>
    )}

    <section class="panel credits" data-pagefind-ignore>
      <div>
        <strong>Credits for this page</strong>
        <span class="small">{usedSources.length ? `Research: ${usedSources.map((s) => s.data.name + (s.data.author ? ` (${s.data.author})` : '')).join(', ')}.` : 'No sources cited yet.'} Photographs credited per image. Last reviewed {d.last_reviewed.toISOString().slice(0, 10)}.</span>
      </div>
      <a class="btn" href={CONTRIBUTE_URL}>Request a correction</a>
    </section>
  </div>
</Base>

<script>
  const img = document.getElementById('hero-img') as HTMLImageElement | null;
  const cap = document.getElementById('hero-cap');
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('.thumb')];
  for (const t of thumbs) {
    t.addEventListener('click', () => {
      if (!img || !cap) return;
      const ds = t.dataset;
      img.src = ds.file!; img.alt = ds.alt!; img.width = Number(ds.w); img.height = Number(ds.h);
      cap.replaceChildren(ds.caption ? `${ds.caption} Photo: ` : 'Photo: ');
      const credit = ds.creditUrl ? Object.assign(document.createElement('a'), { href: ds.creditUrl, textContent: ds.credit }) : document.createTextNode(ds.credit!);
      cap.append(credit, ds.license ? ` · ${ds.license} · ` : ' · ', Object.assign(document.createElement('a'), { href: ds.source, textContent: 'original' }));
      for (const o of thumbs) o.setAttribute('aria-pressed', String(o === t));
    });
  }
</script>

<style>
  .model { display: flex; flex-direction: column; gap: 40px; padding-top: 24px; padding-bottom: 56px; }
  .crumbs { font-size: 13px; color: var(--muted); display: flex; gap: 8px; flex-wrap: wrap; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs [aria-current] { color: var(--ink); }
  .notice { margin: 0; }
  .small { font-size: 13px; }
  .top { display: flex; flex-wrap: wrap; gap: 48px; }
  .gallery { flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
  .hero-img { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .plate { background: var(--photo-ground); border-radius: 12px; aspect-ratio: 4 / 3; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .plate img { width: 100%; height: 100%; object-fit: contain; }
  .plate svg { width: 60%; height: auto; max-width: 300px; }
  .hero-img figcaption { font-size: 12px; color: var(--muted); }
  .hero-img .cap-text { color: var(--ink-2); }
  .hero-img figcaption a { color: var(--muted); }
  .thumbs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(72px, 1fr)); gap: 10px; }
  .thumb { display: block; width: 100%; aspect-ratio: 1; padding: 0; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: var(--plate); cursor: pointer; }
  .thumb[aria-pressed='true'] { border: 2px solid var(--accent); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .elsewhere { display: flex; flex-direction: column; gap: 10px; padding: 16px; border: 1px solid var(--line); border-radius: 10px; background: var(--wash); }
  .elsewhere__group { display: flex; flex-direction: column; gap: 4px; }
  .elsewhere ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 14px; }
  .elsewhere li a { display: inline-block; padding: 4px 0; }
  .facts { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .title { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .title .lede { font-size: 17px; }
  .barometer { display: flex; flex-direction: column; gap: 12px; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .label { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; }
  .bar-entry { display: flex; flex-direction: column; gap: 6px; }
  .bar-label { font-size: 14px; font-weight: 600; }
  .bands { margin: 0; display: flex; flex-direction: column; }
  .bands div { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; border-bottom: 1px solid var(--line-soft); font-size: 14px; }
  .bands div:first-child dd { font-size: 18px; font-weight: 600; }
  .bands dt { color: var(--ink-2); }
  .bands dd { margin: 0; white-space: nowrap; }
  .sales { display: flex; flex-direction: column; gap: 20px; }
  .sales__group { display: flex; flex-direction: column; gap: 10px; }
  .sales h3 { margin: 0; font-size: 16px; }
  .sales-table { min-width: 560px; }
  .sales-table td a { text-decoration: none; }
  .sales-table td.mono { white-space: nowrap; }
  .specs { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 24px; border-top: 1px solid var(--line); }
  .specs div { display: flex; flex-direction: column; gap: 2px; padding: 12px 0; border-bottom: 1px solid var(--line-soft); }
  .specs dt { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .specs dd { margin: 0; font-size: 15px; font-weight: 500; }
  .specs dd.unknown { color: var(--muted); font-weight: 400; }
  .ref-notes { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 4px; }
  .read-more { display: flex; flex-direction: column; gap: 16px; }
