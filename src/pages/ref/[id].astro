---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Dial from '../../components/Dial.astro';
import { formatYears, formatRange, href, KIND_LABEL, CONTRIBUTE_URL } from '../../lib/site';

export async function getStaticPaths() {
  const refs = await getCollection('references');
  return refs.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const family = await getEntry(d.family);
const sources = Object.fromEntries((await getCollection('sources')).map((s) => [s.id, s]));
const cites = Object.fromEntries(d.citations.map((c) => [c.id, c]));
const siblings = (await getCollection('references', (r) => r.data.family.id === d.family.id && r.id !== entry.id))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const years = formatYears(d.years);
const specs = [
  ['Reference', d.reference],
  ['Produced', years],
  ['Type', KIND_LABEL[d.kind]],
  ['Movement', [d.movement.calibre, d.movement.winding].filter(Boolean).join(', ') || null],
  ['Case', d.case.construction],
  ['Material', d.case.material],
  ['Diameter', d.case.diameter_mm ? `${d.case.diameter_mm} mm` : null],
  ['Dial', d.dial],
  ['Nicknames', d.nicknames.join(', ') || null]
] as const;
const [hero, ...thumbs] = d.images;
const eyebrow = [family?.data.name, KIND_LABEL[d.kind], d.reference && `Ref. ${d.reference}`].filter(Boolean).join(' · ');
const usedSources = [...new Set(d.citations.map((c) => c.source.id))].map((id) => sources[id]).filter(Boolean);
---
<Base title={d.name} description={d.summary ?? `${d.name}, an Enicar ${family?.data.name} reference.`} section="catalog" searchable>
  <div class="wrap model">
    <nav aria-label="Breadcrumb" class="crumbs">
      <a href="/">Catalog</a><span aria-hidden="true">/</span>
      <a href={href.family(d.family.id)}>{family?.data.name}</a><span aria-hidden="true">/</span>
      <span aria-current="page">{d.name}</span>
    </nav>

    {d.status === 'draft' && (
      <p class="notice"><strong>Draft record.</strong> Details on this page have not yet been checked against a cited source and may be wrong. Gaps are listed below.</p>
    )}

    <section class="top">
      <div class="gallery">
        <figure class="hero-img">
          <div class="plate">{hero ? <img src={hero.file} alt={hero.alt}> : <Dial kind={d.kind} size={300} />}</div>
          <figcaption data-pagefind-ignore>
            {hero ? <>Photo: {hero.credit_url ? <a href={hero.credit_url}>{hero.credit}</a> : hero.credit} · {hero.license}</> : 'Photo wanted. Own one? Send it in with permission to publish.'}
          </figcaption>
        </figure>
        {thumbs.length > 0 && (
          <ul class="thumbs">
            {thumbs.map((t) => <li><img src={t.file} alt={t.alt} loading="lazy"><span>{t.credit}</span></li>)}
          </ul>
        )}
      </div>

      <div class="facts">
        <div class="title">
          <p class="eyebrow">{eyebrow}</p>
          <h1>{d.name}</h1>
          {d.summary && <p class="lede">{d.summary}</p>}
          <span class={`badge ${d.status}`}>{d.status === 'draft' ? 'Draft, unverified' : 'Verified'}</span>
        </div>

        <div class="card barometer">
          <div class="row"><span class="label">Price barometer</span>
            {d.barometer && cites[d.barometer.cite] && <a class="muted small" href={cites[d.barometer.cite].url}>Source: {sources[cites[d.barometer.cite].source.id]?.data.name}, {d.barometer.edition}</a>}
          </div>
          {d.barometer ? (
            <>
              <span class="mono price">{formatRange(d.barometer)}</span>
              <span class="muted small">{d.barometer.condition}. Quoted as published, never adjusted by us.</span>
            </>
          ) : (
            <span class="muted small">No barometer figure yet. Ranges will be quoted from enicar.org once permission is in place.</span>
          )}
        </div>

        <dl class="specs">
          {specs.map(([k, v]) => (
            <div><dt>{k}</dt><dd class={v ? '' : 'unknown'}>{v ?? 'Unknown'}</dd></div>
          ))}
        </dl>
      </div>
    </section>

    <section class="body">
      <article class="history">
        <h2>History</h2>
        {d.history.length === 0 && <p class="muted">No history written yet. Paragraphs are added only with a citation for each claim.</p>}
        {d.history.map((p) => (
          <p>{p.text} {p.cites.map((id) => cites[id] && <a class="cite" href={cites[id].url}>{sources[cites[id].source.id]?.data.name}</a>)}</p>
        ))}

        {d.variants.length > 0 && (
          <>
            <h3>Variants</h3>
            <div class="variants">
              {d.variants.map((v) => (
                <div class="variant">
                  {v.years && <span class="mono muted small">{v.years}</span>}
                  <strong>{v.name}</strong>
                  <span class="small">{v.tell}</span>
                </div>
              ))}
            </div>
          </>
        )}

        {d.gaps.length > 0 && (
          <>
            <h3>Known gaps</h3>
            <ul class="gaps">{d.gaps.map((g) => <li>{g}</li>)}</ul>
          </>
        )}
      </article>

      <aside class="deeper" data-pagefind-ignore>
        <h2>Go deeper</h2>
        {d.citations.length === 0 ? <p class="muted small">No sources cited yet.</p> : (
          <ol>
            {d.citations.map((c) => (
              <li class="card src">
                <a href={c.url}><strong>{c.title}</strong></a>
                <span class="muted small">{sources[c.source.id]?.data.name} · read {c.retrieved.toISOString().slice(0, 10)}</span>
              </li>
            ))}
          </ol>
        )}
        <a href="/sources/">Open the full source map</a>
      </aside>
    </section>

    {siblings.length > 0 && (
      <section class="siblings" data-pagefind-ignore>
        <h2>More in the {family?.data.name} family</h2>
        <ul>{siblings.map((s) => <li><a href={href.ref(s.id)}>{s.data.name}</a></li>)}</ul>
      </section>
    )}

    <section class="panel credits" data-pagefind-ignore>
      <div>
        <strong>Credits for this page</strong>
        <span class="small">{usedSources.length ? `Research: ${usedSources.map((s) => s.data.name).join(', ')}.` : 'No sources cited yet.'} Photographs credited per image. Last reviewed {d.last_reviewed.toISOString().slice(0, 10)}.</span>
      </div>
      <a class="btn" href={CONTRIBUTE_URL}>Request a correction</a>
    </section>
  </div>
</Base>

<style>
  .model { display: flex; flex-direction: column; gap: 40px; padding-top: 24px; padding-bottom: 56px; }
  .crumbs { font-size: 13px; color: var(--muted); display: flex; gap: 8px; flex-wrap: wrap; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs [aria-current] { color: var(--ink); }
  .notice { margin: 0; }
  .small { font-size: 13px; }
  .top { display: flex; flex-wrap: wrap; gap: 48px; }
  .gallery { flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
  .hero-img { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .plate { background: var(--plate); border-radius: 12px; aspect-ratio: 4 / 3; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .plate img { width: 100%; height: 100%; object-fit: cover; }
  .plate svg { width: 60%; height: auto; max-width: 300px; }
  .hero-img figcaption { font-size: 12px; color: var(--muted); }
  .thumbs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 12px; }
  .thumbs img { aspect-ratio: 1; object-fit: cover; border-radius: 8px; }
  .thumbs span { font-size: 11px; color: var(--muted); }
  .facts { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 28px; }
  .title { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .title .lede { font-size: 17px; }
  .barometer { display: flex; flex-direction: column; gap: 12px; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .label { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; }
  .price { font-size: 32px; font-weight: 500; }
  .specs { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 24px; border-top: 1px solid var(--line); }
  .specs div { display: flex; flex-direction: column; gap: 2px; padding: 12px 0; border-bottom: 1px solid var(--line-soft); }
  .specs dt { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .specs dd { margin: 0; font-size: 15px; font-weight: 500; }
  .specs dd.unknown { color: var(--muted); font-weight: 400; }
  .body { display: flex; flex-wrap: wrap; gap: 48px; }
  .history { flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .history p { margin: 0; font-size: 17px; line-height: 1.6; }
  .history h3 { margin: 16px 0 0; font-size: 18px; font-weight: 600; }
  .variants { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 12px; }
  .variant { display: flex; flex-direction: column; gap: 6px; padding: 14px; border: 1px solid var(--line); border-radius: 10px; }
  .gaps { margin: 0; padding-left: 20px; color: var(--ink-2); }
  .deeper { flex: 1 1 320px; max-width: 440px; display: flex; flex-direction: column; gap: 16px; }
  .deeper ol { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .src { padding: 14px 16px; display: flex; flex-direction: column; gap: 4px; }
  .src a { text-decoration: none; }
  .siblings ul { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .siblings a { display: inline-flex; min-height: 40px; align-items: center; padding: 0 14px; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; font-size: 14px; }
  .credits { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between; }
  .credits div { flex: 1 1 420px; display: flex; flex-direction: column; gap: 6px; color: var(--ink-2); }
  .credits strong { color: var(--ink); }
  @media (max-width: 520px) { .specs { grid-template-columns: 1fr; } }
</style>
