---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Dial from '../../components/Dial.astro';
import { formatYears, formatRange, href, KIND_LABEL, CONTRIBUTE_URL } from '../../lib/site';

export async function getStaticPaths() {
  const refs = await getCollection('references');
  return refs.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const family = await getEntry(d.family);
const sources = Object.fromEntries((await getCollection('sources')).map((s) => [s.id, s]));
const cites = Object.fromEntries(d.citations.map((c) => [c.id, c]));
const siblings = (await getCollection('references', (r) => r.data.family.id === d.family.id && r.id !== entry.id))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));

const mm = (v: number | null) => (v ? `${v} mm` : null);
const years = formatYears(d.years);
const specs = [
  ['References', d.references.map((r) => r.number).join(', ') || null],
  ['Produced', years],
  ['Type', KIND_LABEL[d.kind]],
  ['Movement', [d.movement.calibres.join(', '), d.movement.winding].filter(Boolean).join(' · ') || null],
  ['Case', d.case.construction],
  ['Material', d.case.material],
  ['Diameter', mm(d.case.diameter_mm) ?? (d.variants.some((v) => v.diameter_mm) ? 'Varies by generation' : null)],
  ['Lug width', mm(d.case.lug_mm) ?? (d.variants.some((v) => v.lug_mm) ? 'Varies by generation' : null)],
  ['Thickness', mm(d.case.thickness_mm)],
  ['Dial', d.dial],
  ['Nicknames', d.nicknames.join(', ') || null]
] as const;
const vYears = (y: { from: number | null; to: number | null }) =>
  y.from && y.to ? `${y.from} to ${y.to}` : y.from ? `${y.from} onward` : '';
const rows = [
  ['Years', (v: any) => vYears(v.years)],
  ['Diameter', (v: any) => mm(v.diameter_mm)],
  ['Lugs', (v: any) => mm(v.lug_mm)],
  ['Calibre', (v: any) => v.calibres.join(', ')],
  ['Case', (v: any) => v.case],
  ['Hands', (v: any) => v.hands],
  ['Bezel', (v: any) => v.bezel],
  ['Dials', (v: any) => v.dials.join(', ')],
  ['Crowns', (v: any) => v.crowns]
] as const;
const usedRows = rows.filter(([, f]) => d.variants.some((v) => f(v)));
const variantCites = [...new Set(d.variants.flatMap((v) => v.cites))].map((id) => cites[id]).filter(Boolean);
const [hero] = d.images;
const eyebrow = [family?.data.name, KIND_LABEL[d.kind], d.references[0] && `Ref. ${d.references[0].number}`].filter(Boolean).join(' · ');
const usedSources = [...new Set(d.citations.map((c) => c.source.id))].map((id) => sources[id]).filter(Boolean);
const srcName = (c: any) => sources[c.source.id]?.data.name;
// Group photo links: general ones first, then by generation in table order.
const groupOrder = [null, ...d.variants.map((v) => v.name)];
const elsewhere = groupOrder
  .map((g) => [g ?? 'All generations', d.photos_elsewhere.filter((p) => p.variant === g)] as const)
  .filter(([, links]) => links.length > 0);
const handle = (label: string) => label.match(/^@\S+/)?.[0] ?? label;
---
<Base title={d.name} description={d.summary ?? `${d.name}, an Enicar ${family?.data.name} reference.`} section="catalog" searchable>
  <div class="wrap model">
    <nav aria-label="Breadcrumb" class="crumbs">
      <a href="/">Catalog</a><span aria-hidden="true">/</span>
      <a href={href.family(d.family.id)}>{family?.data.name}</a><span aria-hidden="true">/</span>
      <span aria-current="page">{d.name}</span>
    </nav>

    {d.status === 'draft' && (
      <p class="notice"><strong>Draft record.</strong> Details here are still being checked against their sources and may be incomplete. Open gaps are listed at the bottom of the page.</p>
    )}

    <section class="top">
      <div class="gallery" data-pagefind-ignore>
        <figure class="hero-img">
          <div class="plate">
            {hero ? <img id="hero-img" src={hero.file} alt={hero.alt} width={hero.width} height={hero.height}> : <Dial kind={d.kind} size={300} />}
          </div>
          <figcaption id="hero-cap">
            {hero ? <>Photo: {hero.credit_url ? <a href={hero.credit_url}>{hero.credit}</a> : hero.credit} · {hero.license} · <a href={hero.source_url}>original</a></> : (d.photos_elsewhere.length ? 'No photo with permission yet; see the links below.' : 'Photo wanted. Own one? Send it in with permission to publish.')}
          </figcaption>
        </figure>
        {d.images.length > 1 && (
          <ul class="thumbs">
            {d.images.map((t, i) => (
              <li><button type="button" class="thumb" aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`Show photo: ${t.alt}`}
                data-file={t.file} data-alt={t.alt} data-w={t.width} data-h={t.height}
                data-credit={t.credit} data-credit-url={t.credit_url ?? ''} data-license={t.license} data-source={t.source_url}>
                <img src={t.thumb} alt="" loading="lazy">
              </button></li>
            ))}
          </ul>
        )}
        {elsewhere.length > 0 && (
          <div class="elsewhere">
            <strong>Photos elsewhere</strong>
            <span class="small muted">We only show photos we have permission to use. These link to the photographers' own pages.</span>
            {elsewhere.map(([group, links]) => (
              <div class="elsewhere__group">
                <span class="eyebrow">{group}</span>
                <ul>{links.map((p) => <li><a href={p.url} rel="noopener">{p.label}</a></li>)}</ul>
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="facts">
        <div class="title">
          <p class="eyebrow">{eyebrow}</p>
          <h1>{d.name}</h1>
          {d.summary && <p class="lede">{d.summary}</p>}
          <span class={`badge ${d.status}`}>{d.status === 'draft' ? 'Draft, being checked' : 'Verified'}</span>
        </div>

        <div class="card barometer">
          <div class="row"><span class="label">Price</span>
            {d.barometer && cites[d.barometer.cite] && <a class="muted small" href={cites[d.barometer.cite].url}>Source: {srcName(cites[d.barometer.cite])}, {d.barometer.edition}</a>}
          </div>
          {d.barometer ? (
            <>
              <span class="mono price">{formatRange(d.barometer)}</span>
              <span class="muted small">{d.barometer.condition}. Quoted as published, never adjusted by us.</span>
            </>
          ) : (
            <span class="muted small">No price yet. Ranges will come from the enicar.org barometer once permission is in place, and from logged sales.</span>
          )}
        </div>

        <dl class="specs">
          {specs.filter(([k, v]) => v || ['References', 'Produced', 'Movement', 'Case', 'Diameter'].includes(k)).map(([k, v]) => (
            <div><dt>{k}</dt><dd class={v ? '' : 'unknown'}>{v ?? 'Unknown'}</dd></div>
          ))}
        </dl>
        {d.references.some((r) => r.note) && (
          <ul class="ref-notes small muted">
            {d.references.map((r) => <li><span class="mono">{r.number}</span>: {r.note} {r.cites.map((id) => cites[id] && <a class="cite" href={cites[id].url}>{srcName(cites[id])}</a>)}</li>)}
          </ul>
        )}
      </div>
    </section>

    {d.read_more.length > 0 && (
      <section class="read-more" aria-labelledby="rm-h">
        <h2 id="rm-h">Read the full story</h2>
        <ul>
          {d.read_more.map((m) => (
            <li class="card">
              <a href={m.url} class="rm-title">{m.title}
                <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 9l6-6M5 3h4v4"></path></svg>
              </a>
              <span class="muted small">{sources[m.source.id]?.data.name}{sources[m.source.id]?.data.author && `, ${sources[m.source.id].data.author}`}</span>
              {m.note && <span class="small">{m.note}</span>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {d.variants.length > 0 && (
      <section class="gens" aria-labelledby="gen-h">
        <div class="gens__head">
          <h2 id="gen-h">Generations</h2>
          {variantCites.length > 0 && <span class="small muted">Specs from {variantCites.map((c) => <a class="cite" href={c.url}>{srcName(c)}</a>)}</span>}
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th scope="col"><span class="sr-only">Spec</span></th>{d.variants.map((v) => <th scope="col">{v.name}</th>)}</tr>
            </thead>
            <tbody>
              {usedRows.map(([label, f]) => (
                <tr><th scope="row">{label}</th>{d.variants.map((v) => <td>{f(v) || '—'}</td>)}</tr>
              ))}
              <tr><th scope="row">How to tell</th>{d.variants.map((v) => <td>{v.tell}</td>)}</tr>
              {d.photos_elsewhere.some((p) => p.variant) && (
                <tr><th scope="row">Photos</th>{d.variants.map((v) => {
                  const links = d.photos_elsewhere.filter((p) => p.variant === v.name);
                  return <td>{links.length ? links.map((p, i) => <>{i > 0 && ', '}<a href={p.url} rel="noopener">{handle(p.label)}</a></>) : '—'}</td>;
                })}</tr>
              )}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {d.history.length > 0 && (
      <section class="history">
        <h2>History</h2>
        {d.history.map((p) => (
          <p>{p.text} {p.cites.map((id) => cites[id] && <a class="cite" href={cites[id].url}>{srcName(cites[id])}</a>)}</p>
        ))}
      </section>
    )}

    <section class="bottom" data-pagefind-ignore>
      <div class="sources-list">
        <h2>Sources</h2>
        {d.citations.length === 0 ? <p class="muted small">No sources cited yet.</p> : (
          <ol>
            {d.citations.map((c) => (
              <li class="card src">
                <a href={c.url}><strong>{c.title}</strong></a>
                <span class="muted small">{srcName(c)} · read {c.retrieved.toISOString().slice(0, 10)}{sources[c.source.id]?.data.tier === 'listing' ? ' · dealer listing' : ''}</span>
              </li>
            ))}
          </ol>
        )}
      </div>
      {d.gaps.length > 0 && (
        <div class="gaps">
          <h2>Still missing</h2>
          <ul>{d.gaps.map((g) => <li>{g}</li>)}</ul>
          <a href={CONTRIBUTE_URL}>Can you help? Send evidence</a>
        </div>
      )}
    </section>

    {siblings.length > 0 && (
      <section class="siblings" data-pagefind-ignore>
        <h2>More in the {family?.data.name} family</h2>
        <ul>{siblings.map((s) => <li><a href={href.ref(s.id)}>{s.data.name}</a></li>)}</ul>
      </section>
    )}

    <section class="panel credits" data-pagefind-ignore>
      <div>
        <strong>Credits for this page</strong>
        <span class="small">{usedSources.length ? `Research: ${usedSources.map((s) => s.data.name + (s.data.author ? ` (${s.data.author})` : '')).join(', ')}.` : 'No sources cited yet.'} Photographs credited per image. Last reviewed {d.last_reviewed.toISOString().slice(0, 10)}.</span>
      </div>
      <a class="btn" href={CONTRIBUTE_URL}>Request a correction</a>
    </section>
  </div>
</Base>

<script>
  const img = document.getElementById('hero-img') as HTMLImageElement | null;
  const cap = document.getElementById('hero-cap');
  const thumbs = [...document.querySelectorAll<HTMLButtonElement>('.thumb')];
  for (const t of thumbs) {
    t.addEventListener('click', () => {
      if (!img || !cap) return;
      const ds = t.dataset;
      img.src = ds.file!; img.alt = ds.alt!; img.width = Number(ds.w); img.height = Number(ds.h);
      cap.replaceChildren('Photo: ');
      const credit = ds.creditUrl ? Object.assign(document.createElement('a'), { href: ds.creditUrl, textContent: ds.credit }) : document.createTextNode(ds.credit!);
      cap.append(credit, ` · ${ds.license} · `, Object.assign(document.createElement('a'), { href: ds.source, textContent: 'original' }));
      for (const o of thumbs) o.setAttribute('aria-pressed', String(o === t));
    });
  }
</script>

<style>
  .model { display: flex; flex-direction: column; gap: 40px; padding-top: 24px; padding-bottom: 56px; }
  .crumbs { font-size: 13px; color: var(--muted); display: flex; gap: 8px; flex-wrap: wrap; }
  .crumbs a { color: var(--muted); text-decoration: none; }
  .crumbs [aria-current] { color: var(--ink); }
  .notice { margin: 0; }
  .small { font-size: 13px; }
  .top { display: flex; flex-wrap: wrap; gap: 48px; }
  .gallery { flex: 1 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
  .hero-img { margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .plate { background: var(--plate); border-radius: 12px; aspect-ratio: 4 / 3; display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .plate img { width: 100%; height: 100%; object-fit: contain; }
  .plate svg { width: 60%; height: auto; max-width: 300px; }
  .hero-img figcaption { font-size: 12px; color: var(--muted); }
  .hero-img figcaption a { color: var(--muted); }
  .thumbs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(72px, 1fr)); gap: 10px; }
  .thumb { display: block; width: 100%; aspect-ratio: 1; padding: 0; border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: var(--plate); cursor: pointer; }
  .thumb[aria-pressed='true'] { border: 2px solid var(--accent); }
  .thumb img { width: 100%; height: 100%; object-fit: cover; }
  .elsewhere { display: flex; flex-direction: column; gap: 10px; padding: 16px; border: 1px solid var(--line); border-radius: 10px; background: var(--wash); }
  .elsewhere__group { display: flex; flex-direction: column; gap: 4px; }
  .elsewhere ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 14px; }
  .elsewhere li a { display: inline-block; padding: 4px 0; }
  .facts { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .title { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .title .lede { font-size: 17px; }
  .barometer { display: flex; flex-direction: column; gap: 12px; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .label { font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; }
  .price { font-size: 32px; font-weight: 500; }
  .specs { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 24px; border-top: 1px solid var(--line); }
  .specs div { display: flex; flex-direction: column; gap: 2px; padding: 12px 0; border-bottom: 1px solid var(--line-soft); }
  .specs dt { font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .specs dd { margin: 0; font-size: 15px; font-weight: 500; }
  .specs dd.unknown { color: var(--muted); font-weight: 400; }
  .ref-notes { margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 4px; }
  .read-more { display: flex; flex-direction: column; gap: 16px; }
  .read-more ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .read-more li { display: flex; flex-direction: column; gap: 6px; padding: 20px; }
  .rm-title { font-size: 18px; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; color: var(--accent); }
  .gens { display: flex; flex-direction: column; gap: 16px; }
  .gens__head { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 12px; }
  table { width: 100%; min-width: 760px; border-collapse: collapse; font-size: 14px; }
  thead th { background: var(--wash); text-align: left; padding: 12px 16px; font-size: 13px; font-weight: 600; }
  tbody th { text-align: left; padding: 12px 16px; font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); font-weight: 600; white-space: nowrap; vertical-align: top; }
  td { padding: 12px 16px; vertical-align: top; border-top: 1px solid var(--line-soft); }
  tbody th { border-top: 1px solid var(--line-soft); }
  .history { display: flex; flex-direction: column; gap: 16px; max-width: 760px; }
  .history p { margin: 0; font-size: 17px; line-height: 1.6; }
  .bottom { display: flex; flex-wrap: wrap; gap: 40px; }
  .sources-list { flex: 1 1 420px; display: flex; flex-direction: column; gap: 14px; }
  .sources-list ol { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .src { padding: 14px 16px; display: flex; flex-direction: column; gap: 4px; }
  .src a { text-decoration: none; }
  .gaps { flex: 1 1 320px; display: flex; flex-direction: column; gap: 12px; }
  .gaps ul { margin: 0; padding-left: 20px; color: var(--ink-2); }
  .siblings ul { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .siblings a { display: inline-flex; min-height: 40px; align-items: center; padding: 0 14px; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; font-size: 14px; }
  .credits { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between; }
  .credits div { flex: 1 1 420px; display: flex; flex-direction: column; gap: 6px; color: var(--ink-2); }
  .credits strong { color: var(--ink); }
  @media (max-width: 520px) { .specs { grid-template-columns: 1fr; } }
</style>
