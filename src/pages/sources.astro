---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { CONTRIBUTE_URL } from '../lib/site';

const sources = await getCollection('sources');
const refs = await getCollection('references');
// Photographers who let us use their photos, with how many are on the site.
const photographers = (await getCollection('permissions')).map((p) => ({
  ...p.data,
  count: refs.reduce((n, r) => n + r.data.images.filter((i) => i.permission_ref?.id === p.id).length, 0)
})).sort((a, b) => b.count - a.count);
const usage = Object.fromEntries(sources.map((s) => [s.id, refs.filter((r) => r.data.citations.some((c) => c.source.id === s.id)).length]));
---
<Base title="Sources and credits" section="sources">
  <div class="wrap sources">
    <section class="intro">
      <h1>Sources</h1>
      <p class="lede">Most of what's here comes from collectors who did the research first. These are the sources we cite and what we use each one for.</p>
    </section>

    <section class="block">
      <h2>What we cite</h2>
      <div class="grid">
        {sources.map((s) => (
          <article class="card src">
            <div class="src__top">
              <div>
                <a href={s.data.url} class="src__name">{s.data.name}</a>
                <span class="muted small">{s.data.author ?? 'Author to be confirmed'}</span>
              </div>
              <span class="badge accent">{s.data.kind}</span>
            </div>
            <p>{s.data.what}</p>
            {s.data.use && (
              <div class="src__use">
                <span class="eyebrow">We use it for</span>
                <span class="small">{s.data.use}</span>
              </div>
            )}
            <span class="muted small">Cited on {usage[s.id]} {usage[s.id] === 1 ? 'record' : 'records'}{s.data.status === 'to-confirm' ? ' · details to be confirmed' : ''}</span>
          </article>
        ))}
      </div>
    </section>

    <section class="block">
      <h2>Photographers</h2>
      <p class="small">These collectors and dealers let us show their photos. Each photo on the site credits and links back to them.</p>
      <ul class="photographers">
        {photographers.map((p) => (
          <li class="card">
            <a href={p.link ?? p.profile_url} class="src__name">{p.credit_as}</a>
            <span class="muted small">{p.count} {p.count === 1 ? 'photo' : 'photos'}{p.link && <> · <a href={p.profile_url}>Instagram</a></>}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="policies card">
      <div>
        <h2>Image policy</h2>
        <p>Photos from Instagram and photographers' own sites are shown only with the photographer's permission. Photos posted publicly on watch forums are shown with credit and a link to the post. Every photo is credited. If a photo of yours is here and you'd rather it wasn't, tell us and we'll remove it.</p>
      </div>
      <div>
        <h2>Prices</h2>
        <p>Price guides come from enicar.org's Watch Value Barometer, with permission, quoted as published with the edition named. Sales come from auction houses that publish their results, and listings from eBay's official API and dealers' own sites, each with the date and a link. We don't record buyers or sellers.</p>
      </div>
      <div>
        <h2>Corrections</h2>
        <p>Dates and attributions follow the sources. Where sources disagree, we say so. If something is wrong, send a correction with your evidence and we'll credit you.</p>
        <a class="btn" href={CONTRIBUTE_URL}>Request a correction</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .sources { display: flex; flex-direction: column; gap: 48px; padding-top: 56px; padding-bottom: 64px; }
  .intro { display: flex; flex-direction: column; gap: 16px; max-width: 760px; }
  .block { display: flex; flex-direction: column; gap: 20px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 20px; }
  .small { font-size: 13px; }
  .src { display: flex; flex-direction: column; gap: 14px; }
  .src p { margin: 0; font-size: 15px; }
  .src__top { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
  .src__top > div { display: flex; flex-direction: column; gap: 4px; }
  .src__name { font-size: 20px; font-weight: 600; text-decoration: none; }
  .src__use { display: flex; flex-direction: column; gap: 6px; padding-top: 12px; border-top: 1px solid var(--line-soft); }
  .photographers { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
  .photographers li { padding: 16px 18px; display: flex; flex-direction: column; gap: 4px; }
  .photographers .src__name { font-size: 17px; }
  .policies { display: flex; flex-wrap: wrap; gap: 32px; }
  .policies > div { flex: 1 1 280px; display: flex; flex-direction: column; gap: 10px; align-items: flex-start; }
  .policies h2 { font-size: 18px; }
  .policies p { margin: 0; font-size: 14px; color: var(--ink-2); }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
</style>
