// Cloudflare deploy config. The site is fully static: Cloudflare serves the
// built dist/ folder as files, with no server code. Having this file stops
// `wrangler deploy` from trying to convert the project into a server app.
{
  "name": "enicar",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Branch builds run `wrangler preview`, which needs this block to exist.
  // It can stay empty: assets and settings above apply to previews too.
  "previews": {}
}
